diff --git a/src/interface/aui_notebook_ex.cpp b/src/interface/aui_notebook_ex.cpp
index ef0d265..aa717f0 100644
--- a/src/interface/aui_notebook_ex.cpp
+++ b/src/interface/aui_notebook_ex.cpp
@@ -202,8 +202,10 @@ protected:
 		auto mirror = [](wxImage& img) {
 			img = img = img.Mirror().Rotate90(false);
 		};
-		PrepareTabIcon(m_activeLeftBmp, m_disabledLeftBmp, L"ART_SORT_UP_DARK", size, canvas, offset, mirror, 192);
-		PrepareTabIcon(m_activeRightBmp, m_disabledRightBmp, L"ART_SORT_DOWN_DARK", size, canvas, offset, mirror, 192);
+		// The sort arrows ship in both polarities; leave the choice to the theme
+		// provider so they stay legible on a dark background.
+		PrepareTabIcon(m_activeLeftBmp, m_disabledLeftBmp, L"ART_SORT_UP", size, canvas, offset, mirror, 192);
+		PrepareTabIcon(m_activeRightBmp, m_disabledRightBmp, L"ART_SORT_DOWN", size, canvas, offset, mirror, 192);
 	}
 #endif
 
