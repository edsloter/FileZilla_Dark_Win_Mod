 wxBitmap const& CTheme::LoadBitmap(CLocalPath const& cacheDir, std::wstring const& name, wxSize const& size, bool allowContentScale)
 {
+	// A theme may ship "<name>_dark.png" and "<name>_light.png" next to
+	// "<name>.png". The suffix describes the polarity of the artwork rather than
+	// that of the theme, so the variant matching the current system appearance is
+	// the one to draw.
+	//
+	// Callers that already resolved a polarity themselves - renderer.cpp for the
+	// macOS tree item buttons, or the mirrored sort tabs - name it explicitly, and
+	// that request has to be honoured verbatim instead of being second-guessed.
+	if (!EndsWith(name, L"_light") && !EndsWith(name, L"_dark"))
+	{
+		std::wstring const polarity = wxSystemSettingsNative::GetAppearance().IsDark() ? L"_light" : L"_dark";
+
+		// Themes are free to ship no variants at all, and most icons read fine on
+		// both backgrounds, so fall back to the plain artwork when the preferred
+		// one is missing. LoadBitmap caches the miss, so this costs nothing after
+		// the first call.
+		auto const& preferred = LoadBitmap(cacheDir, name + polarity, size, allowContentScale);
+		if (preferred.IsOk()) {
+			return preferred;
+		}
+	}
